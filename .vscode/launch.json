{
    // F5 启动调试。快捷键 F5；Ctrl+Shift+B 只编译不调试。
    //
    // 目标芯片：STM32F407IGH6（C板，UFBGA176）
    // ELF：build/051_can_motor_control.elf
    // 三套配置，用不上的可以删：
    //   1. J-Link    -> SEGGER J-Link GDB Server -> GDB（本次主要用这个）
    //   2. DAPLink   -> OpenOCD -> GDB（备用，第三周那块DAPLink）
    //   3. ST-Link   -> OpenOCD -> GDB（备用）
    //
    // 换工程名要改三处 executable。
    // 换芯片要同步改 device（和 DAPLink/ST-Link 的 target 配置文件）。

    "version": "0.2.0",

    "configurations": [

        // ============================================================
        // J-Link（本次主要用）
        // ============================================================
        {
            "name": "J-Link (C板)",

            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/051_can_motor_control.elf",

            "request": "launch",
            "type": "cortex-debug",

            // Cortex-Debug 要知道去哪个目录找 JLinkGDBServerCL.exe。
            // 版本号（V956）随安装变化，升级 J-Link 后这里要跟着改。
            "serverpath": "C:/Program Files (x86)/SEGGER/JLink",

            // J-Link GDB Server 需要明确的目标器件名。
            // STM32F407IG 是 ST 的器件名，J-Link 内置器件表里有。
            "servertype": "jlink",
            "device": "STM32F407IG",

            // C板调试口是 SWD 两线（SWDIO/SWCLK），不是 JTAG。
            "interface": "swd",

            // gcc/gdb 所在目录。不写会去系统 PATH 里找，找不到就报
            // "arm-none-eabi-gdb: not found"。
            "armToolchainPath": "E:/Tools/14.3 rel1/bin",

            // 外设寄存器视图。
            "svdFile": "${workspaceFolder}/STM32F407.svd",

            "runToEntryPoint": "main",

            // 裸机工程，不开 FreeRTOS 那一项。
            // "rtos": "FreeRTOS",

            // 程序跑起来后实时观察变量（配合 Ozone 二选一即可）。
            "liveWatch": {
                "enabled": false
            },

            "debuggerArgs": [
                "-iex",
                "set debug-file-directory ${workspaceFolder}/.gdb-debug",
                "-iex",
                "set remotetimeout 20"
            ],

            // F5 之前先编译。标签名必须和 tasks.json 里的 label 一字不差。
            "preLaunchTask": "build"
        },

        // ============================================================
        // DAPLink / CMSIS-DAP（备用）
        // ============================================================
        {
            "name": "DAPLink (C板)",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/051_can_motor_control.elf",
            "request": "launch",
            "type": "cortex-debug",

            "device": "STM32F407IG",

            "servertype": "openocd",
            // OpenOCD 自带的通用配置：CMSIS-DAP 接口 + STM32F4 系列目标。
            // 注意是 stm32f4x.cfg（F4），不是第三周 F103 的 stm32f1x.cfg。
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/stm32f4x.cfg"
            ],

            "armToolchainPath": "E:/Tools/14.3 rel1/bin",

            "runToEntryPoint": "main",

            "liveWatch": {
                "enabled": false
            },

            "debuggerArgs": [
                "-iex",
                "set debug-file-directory ${workspaceFolder}/.gdb-debug",
                "-iex",
                "set remotetimeout 20"
            ],

            "preLaunchTask": "build"
        },

        // ============================================================
        // ST-Link（备用）
        // ============================================================
        {
            "name": "ST-Link (C板)",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/051_can_motor_control.elf",
            "request": "launch",
            "type": "cortex-debug",

            "device": "STM32F407IG",

            "servertype": "openocd",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],

            "armToolchainPath": "E:/Tools/14.3 rel1/bin",

            "runToEntryPoint": "main",

            "liveWatch": {
                "enabled": false
            },

            "debuggerArgs": [
                "-iex",
                "set debug-file-directory ${workspaceFolder}/.gdb-debug",
                "-iex",
                "set remotetimeout 20"
            ],

            "preLaunchTask": "build"
        }
    ]
}
